use nix
# use flake

generate_clangd() {
    echo "🔄 Обновление .clangd на основе текущего g++..."

    local paths
    paths=$(g++ -v -E -x c++ /dev/null 2>&1 | sed -n '/#include <\.\.\.>/,/Конец списка поиска\./p' | grep '^\s*/' | tr -d ' \r')

    if [ -z "$paths" ]; then
        echo "⚠️ Не удалось найти пути include."
        echo "Убедитесь, что команда 'g++' доступна и вы находитесь в nix-окружении."
        return 1
    fi

    cat << 'EOF' > .clangd
CompileFlags:
  Add:
EOF

    # 5. Добавляем каждый путь с флагом -I и в кавычках (безопасно для YAML)
    echo "$paths" | while read -r path; do
        echo "    - \"-I$path\"" >> .clangd
    done

    # 6. Добавляем правила очистки и подавления ошибок
    cat << 'EOF' >> .clangd
  Remove:
    - "-m*"
    - "-W*"
    - "-fno-gnu-unique"
Diagnostics:
  Suppress:
    - "pp_file_not_found"
EOF

    echo "✅ .clangd успешно обновлен!"
}

watch_file .envrc
watch_file shell.nix   # Если используете shell.nix
# watch_file flake.nix # Если используете flake.nix (раскомментируйте)

generate_clangd